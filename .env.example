# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==================================================
# ONLAYN TEST PLATFORMASI SOZLAMALARI
# ==================================================

# 1. Supabase PostgreSQL sozlamalari (Ixtiyoriy - berilmasa o'rnatilgan yuqori tezlikdagi in-memory/persistent DB ishlaydi)
